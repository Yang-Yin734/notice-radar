# 服务器端 .env 模板（deploy/install.sh 会把它复制成仓库根的 .env）
# .env 已在 .gitignore 里，不会被提交。
#
# ⚠️ 这个文件由 bash 直接 source，所以：值里不要有空格、不要加引号、一行一个 KEY=VALUE。

# ── 推送通道（可选，但常驻节点不填就等于白跑：只进归档，不会主动通知你）─────
# 通用 webhook（飞书/钉钉/自建服务都行，POST {"title","markdown"}）
NOTICE_RADAR_WEBHOOK=

# email 通道：二选一 —— 直接给 SMTP_URL，或分开给 HOST/USER/PASS
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=465
# MAIL_TO=
# MAIL_FROM=

# ── 真浏览器（学院源必须有）─────────────────────────────────────────────
# install.sh 会自动写入探测到的路径；手动装 chromium 的话写它的绝对路径。
# NOTICE_RADAR_BROWSER=/usr/bin/google-chrome-stable

# ── 国内对象存储（可选，deploy/oss-sync.sh 用；不配就只走 GitHub）──────────
# OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
# OSS_BUCKET=
# OSS_AK_ID=
# OSS_AK_SECRET=
