<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 窗口背景与系统栏颜色：用应用自己的底色，避免系统栏区域露出白条。
         色值必须与 ui/Tokens.kt 的 Paper.background / Paper.surface 保持一致，
         否则系统栏和内容之间会出现一条颜色不同的边（以前踩过的"底部白条"）。 -->
    <color name="appBackground">#FFFBFAF7</color>
    <color name="appSurface">#FFFFFFFF</color>

    <!-- 应用图标底色：墨黑。取自 App 深色模式那一族暖黑（Tokens.kt 的 Night 系），
         不是冷灰蓝 —— 冷底配米白纸会显脏。前景层 drawable/ic_launcher_foreground.xml
         只画那张纸、三行墨线和一枚朱红小印。 -->
    <color name="ic_launcher_background">#FF1C1917</color>
</resources>