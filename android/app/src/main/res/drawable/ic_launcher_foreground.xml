<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：朱红底上的一张通知单。
  背景色由 values/colors.xml 的 ic_launcher_background 提供，
  所以这里只画纸（左缘从 x=25 起，露出左侧那道朱红竖边）、折角、四条墨线。
  几何参数与 tools/make-icon.py 完全一致（108×108 设计网格），PNG 与矢量不会打架。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 纸：左上直角（贴住那道红边），右上切出 12×12 折角，其余三角圆角 -->
    <path
        android:fillColor="#FBFAF7"
        android:pathData="M25,20 h44 l12,12 v51 a3,3 0 0 1 -3,3 h-50 a3,3 0 0 1 -3,-3 v-63 z" />

    <!-- 折角 -->
    <path
        android:fillColor="#E0D6C4"
        android:pathData="M69,20 L81,32 L69,32 Z" />

    <!-- 墨线：第一行是标题（粗、长），后三行是正文（细、渐短） -->
    <path
        android:fillColor="#17150F"
        android:pathData="M34,36 h40 v6 h-40 z" />
    <path
        android:fillColor="#17150F"
        android:pathData="M34,50 h30 v5 h-30 z" />
    <path
        android:fillColor="#17150F"
        android:pathData="M34,61 h36 v5 h-36 z" />
    <path
        android:fillColor="#17150F"
        android:pathData="M34,72 h16 v5 h-16 z" />
</vector>